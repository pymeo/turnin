# Test environment. The database name is explicit rather than derived through
# Doctrine's dbname_suffix so that `make test` and CI resolve to the exact same
# database, and so that `psql` against it is obvious.
KERNEL_CLASS='App\Kernel'

# APP_ENV is pinned by tests/bootstrap.php, not here, so there is one source of
# truth for which environment the suite runs in.
APP_SECRET=test_only_not_a_production_secret

DATABASE_URL="postgresql://turnin:turnin@postgres:5432/turnin_test?serverVersion=18&charset=utf8"

# Separate Redis logical database so a test run can never evict dev cache.
REDIS_URL=redis://redis:6379/1

# Base URL used by the Playwright suite.
E2E_BASE_URL=http://127.0.0.1:8080
