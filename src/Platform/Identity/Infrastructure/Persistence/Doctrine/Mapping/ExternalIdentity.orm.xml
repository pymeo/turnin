<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Platform\Identity\Domain\ExternalIdentity" table="identity_external_identities">
        <id name="id" type="guid" column="id" />
        <field name="userId" column="user_id" type="identity_user_id" />
        <field name="provider" column="provider" type="string" length="32" enum-type="App\Platform\Identity\Domain\ExternalIdentityProvider" />
        <field name="providerSubject" column="provider_subject" type="string" length="255" />
        <field name="emailAtLinkTime" column="email_at_link_time" type="identity_email" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <unique-constraints>
            <unique-constraint name="identity_external_provider_subject_unique" fields="provider,providerSubject" />
            <unique-constraint name="identity_external_user_provider_unique" fields="userId,provider" />
        </unique-constraints>
    </entity>
</doctrine-mapping>
