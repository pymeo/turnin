<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Platform\Identity\Domain\PersonalProfile" table="identity_personal_profiles">
        <id name="userId" type="identity_user_id" column="user_id" />
        <field name="givenName" column="given_name" type="string" length="100" />
        <field name="familyName" column="family_name" type="string" length="160" />
        <field name="phoneEncrypted" column="phone_encrypted" type="text" nullable="true" />
        <field name="identityEvidence" column="identity_evidence" type="string" enum-type="App\Platform\Identity\Domain\IdentityEvidence" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" />
    </entity>
</doctrine-mapping>
