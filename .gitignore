###> symfony/asset-mapper ###
# Compiled output and downloaded importmap packages: both are reproducible from
# importmap.php with `php bin/console importmap:install`.
/public/assets/
/assets/vendor/
###< symfony/asset-mapper ###

###> tooling ###
# Every tool writes its cache under var/ (see phpstan.neon, phpunit.dist.xml,
# deptrac*.yaml, .php-cs-fixer.dist.php), which is already ignored above. These
# entries only exist so an older local checkout does not commit stale caches.
/.phpstan.cache/
/.phpunit.cache/
/.php-cs-fixer.cache
/.php-cs-fixer.php
/.deptrac.cache
/.deptrac.contexts.cache
/phpunit.xml
###< tooling ###

###> node / playwright ###
/node_modules/
/var/playwright/
###< node / playwright ###

###> graft ###
# The context graph is a local, regenerable cache — `make graph` rebuilds it in
# seconds and every graft query refreshes it on the fly. Committing it would put
# a 200 KB JSON diff on top of every code change for no benefit. See docs/GRAPH.md.
/graft/
# graft also drops a .ignore file so its cards stay greppable by ripgrep; it is
# regenerated by `graft build` like the rest of the graph.
/.ignore
###< graft ###

###> local ###
# Anything that looks like a credential must never reach the remote.
*.pem
*.key
secret*.txt
*secret*.txt
