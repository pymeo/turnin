{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.7",
        "knpuniversity/oauth2-client-bundle": "^2.20",
        "league/oauth2-google": "^5.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "process-timeout": 900
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs-check": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "lint-yaml": "php bin/console lint:yaml config --parse-tags",
        "lint-twig": "php bin/console lint:twig templates",
        "lint-container": "php bin/console lint:container",
        "lint": [
            "@lint-yaml",
            "@lint-twig",
            "@lint-container"
        ],
        "stan": "php bin/console cache:warmup --env=dev --no-interaction && phpstan analyse --memory-limit=1G",
        "architecture": [
            "@php -r \"@mkdir('var/cache/deptrac', 0777, true);\"",
            "deptrac analyse --no-progress --fail-on-uncovered --report-uncovered --cache-file=var/cache/deptrac/layers.cache",
            "deptrac analyse --config-file=deptrac.contexts.yaml --no-progress --fail-on-uncovered --report-uncovered --cache-file=var/cache/deptrac/contexts.cache"
        ],
        "test-reset-db": [
            "php bin/console doctrine:database:drop --force --if-exists --no-interaction --env=test",
            "php bin/console doctrine:database:create --no-interaction --env=test",
            "php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration --env=test"
        ],
        "test-unit": "phpunit --testsuite unit --testdox",
        "test-architecture": "phpunit --testsuite architecture --testdox",
        "test-integration": [
            "@test-reset-db",
            "phpunit --testsuite integration --testdox"
        ],
        "test-functional": [
            "@test-reset-db",
            "phpunit --testsuite functional --testdox"
        ],
        "test": [
            "@test-reset-db",
            "phpunit --testdox"
        ],
        "qa": [
            "@composer validate --strict",
            "@cs-check",
            "@lint",
            "@stan",
            "@architecture",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "name": "pymeo/turnin",
    "description": "Turnin — encuentra automáticamente compañeros compatibles para cambiar turnos.",
    "scripts-descriptions": {
        "cs-check": "Comprueba el estilo de código sin modificar nada.",
        "cs-fix": "Corrige el estilo de código.",
        "lint": "Lint de YAML, plantillas Twig y contenedor de servicios.",
        "stan": "Análisis estático con PHPStan.",
        "architecture": "Comprueba las reglas de dependencia con Deptrac.",
        "test-reset-db": "Recrea la base de datos de test aplicando TODAS las migraciones.",
        "test": "Recrea la base de test y ejecuta toda la suite PHPUnit.",
        "qa": "Puerta de calidad completa."
    }
}
