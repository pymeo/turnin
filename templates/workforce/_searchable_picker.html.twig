<div class="picker flex flex-col gap-3"
     data-controller="searchable-picker"
     data-searchable-picker-endpoint-value="{{ endpoint }}"
     data-searchable-picker-mode-value="{{ mode|default('single') }}"
     data-searchable-picker-allow-local-value="{{ allow_local|default(false) ? 'true' : 'false' }}"
     data-searchable-picker-exclude-field-value="{{ exclude_field|default('') }}"
     data-action="picker:refresh->searchable-picker#refresh picker:clear->searchable-picker#clear picker:exclude->searchable-picker#exclude">
    <label class="picker-label" for="{{ picker_id }}-search">{{ label }}</label>
    <div class="picker-search">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="{{ picker_id }}-search" data-searchable-picker-target="input" placeholder="{{ placeholder }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="{{ picker_id }}-results" aria-expanded="false">
    </div>
    <input type="hidden" name="{{ field_name }}" value="{{ initial_value|default('') }}" data-initial-label="{{ initial_label|default('') }}" data-searchable-picker-target="value">
    <div class="picker-selection" data-searchable-picker-target="selection" aria-live="polite"></div>
    <div class="picker-featured" data-searchable-picker-target="featured" aria-label="Sugerencias"></div>
    <div id="{{ picker_id }}-results" class="picker-results" data-searchable-picker-target="results" role="listbox"></div>
    <div class="flex items-center justify-between gap-3">
        <p class="text-sm text-ink-muted" data-searchable-picker-target="status" role="status"></p>
        <button type="button" class="picker-browse {{ browse|default(true) ? '' : 'hidden' }}" data-action="searchable-picker#open">Ver todas las opciones <span aria-hidden="true">→</span></button>
    </div>
    <button type="button" class="btn-ghost hidden" data-searchable-picker-target="retry" data-action="searchable-picker#retry">Reintentar</button>

    <dialog class="picker-sheet" data-searchable-picker-target="dialog" aria-labelledby="{{ picker_id }}-title">
        <div class="picker-sheet-inner">
            <div class="picker-sheet-handle" aria-hidden="true"></div>
            <header class="picker-sheet-header">
                <div><p class="eyebrow">Explorar</p><h2 id="{{ picker_id }}-title">{{ sheet_title|default(label) }}</h2></div>
                <button type="button" class="picker-close" data-action="searchable-picker#close" aria-label="Cerrar selector">×</button>
            </header>
            <div class="picker-search">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <input data-searchable-picker-target="sheetInput" placeholder="Buscar…" autocomplete="off" aria-label="Buscar opciones">
            </div>
            <div class="picker-sheet-results" data-searchable-picker-target="sheetResults" role="listbox"></div>
            {% if allow_local|default(false) %}
                <div class="picker-local" data-searchable-picker-target="local">
                    <p class="font-semibold">¿No encuentras tu unidad?</p>
                    <p class="text-sm text-ink-muted">Añade su nombre real. Quedará pendiente de normalización.</p>
                    <div class="grid gap-2 sm:grid-cols-[1fr_auto]"><input class="input" data-searchable-picker-target="localName" maxlength="120" placeholder="Ej. Observación 2"><button type="button" class="btn-secondary" data-action="searchable-picker#createLocal">Añadir unidad</button></div>
                </div>
            {% endif %}
        </div>
    </dialog>
</div>
