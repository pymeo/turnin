{% extends 'base.html.twig' %}
{% block title %}Completa tu perfil — Turnin{% endblock %}
{% block body %}
{% set additional_ids = draft ? draft.additionalDestinationIds : [] %}
{% set additional_names = [] %}
{% if draft %}{% for destination in draft.additionalDestinations %}{% set additional_names = additional_names|merge([destination.name]) %}{% endfor %}{% endif %}
<main class="onboarding-shell" data-controller="onboarding" data-onboarding-csrf-value="{{ csrf_token('onboarding') }}">
    {% include 'identity/_authenticated_header.html.twig' %}
    <div class="onboarding-progress" aria-label="Progreso del perfil">
        <div class="flex items-center justify-between text-sm text-ink-muted"><span data-onboarding-target="counter">1 de 7</span><span class="font-medium" data-onboarding-target="progressLabel">Identidad</span></div>
        <div class="progress-track"><span data-onboarding-target="progress"></span></div>
    </div>
    <p class="alert-critical hidden" data-onboarding-target="error" role="alert"></p>

    <section class="onboarding-step" data-onboarding-target="step" data-step="name">
        <p class="eyebrow">Empezamos por ti</p>
        <h1>¿Cómo te llamas?</h1>
        <p class="step-copy">Así podrán distinguirte tus compañeros y responsables.</p>
        <div class="grid gap-4 sm:grid-cols-2">
            <label class="field"><span class="field-label">Nombre</span><input class="input" name="given_name" autocomplete="given-name" value="{{ profile ? profile.givenName : '' }}" required></label>
            <label class="field"><span class="field-label">Apellidos</span><input class="input" name="family_name" autocomplete="family-name" value="{{ profile ? profile.familyName : '' }}" required></label>
        </div>
        <button class="btn-primary btn-block" type="button" data-action="onboarding#next">Continuar</button>
    </section>

    <section class="onboarding-step hidden" data-onboarding-target="step" data-step="identity" data-complete="{{ profile and profile.identityProvided ? 'true' : 'false' }}">
        <p class="eyebrow">Protegemos tus cambios</p>
        <h1>¿Cómo identificamos tu cuenta?</h1>
        <p class="step-copy">Evita cuentas duplicadas y mantiene Turnin útil para todos.</p>
        {% if profile and profile.identityProvided %}
            <div class="alert-success"><span aria-hidden="true">✓</span><span>DNI/NIE y teléfono protegidos para esta cuenta.</span></div>
        {% else %}
            <label class="field"><span class="field-label">DNI/NIE</span><input class="input" name="identity_document" autocomplete="off" autocapitalize="characters" placeholder="12345678Z" required></label>
            <label class="field"><span class="field-label">Teléfono</span><input class="input" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="600 123 123" required></label>
            <p class="privacy-note"><span aria-hidden="true">🔒</span> No mostramos estos datos a otros usuarios.</p>
        {% endif %}
        <div class="step-actions"><button class="btn-ghost" type="button" data-action="onboarding#back">Atrás</button><button class="btn-primary" type="button" data-action="onboarding#next">Continuar</button></div>
    </section>

    <section class="onboarding-step hidden" data-onboarding-target="step" data-step="workplace">
        <p class="eyebrow">Tu contexto laboral</p><h1>¿Dónde trabajas?</h1><p class="step-copy">Busca por nombre, municipio o provincia.</p>
        {% include 'workforce/_searchable_picker.html.twig' with {picker_id: 'workplace', label: 'Centro de trabajo', placeholder: 'Nombre, municipio o provincia…', endpoint: '/api/workplaces', field_name: 'workplace_id', initial_value: draft ? draft.workplaceId : '', initial_label: draft ? draft.workplaceName : '', browse: false} %}
        <div class="step-actions"><button class="btn-ghost" type="button" data-action="onboarding#back">Atrás</button><button class="btn-primary" type="button" data-action="onboarding#next">Continuar</button></div>
    </section>

    <section class="onboarding-step hidden" data-onboarding-target="step" data-step="category">
        <p class="eyebrow">Tu trabajo</p><h1>¿Qué trabajo haces?</h1><p class="step-copy">Puedes buscar por el nombre habitual o por su equivalente oficial.</p>
        {% include 'workforce/_searchable_picker.html.twig' with {picker_id: 'category', label: 'Categoría profesional', placeholder: 'Enfermero, TCAE, celador…', endpoint: '/api/staff-categories', field_name: 'staff_category_id', initial_value: draft ? draft.staffCategoryId : '', initial_label: draft ? draft.staffCategoryName : '', sheet_title: 'Selecciona tu categoría'} %}
        <div class="step-actions"><button class="btn-ghost" type="button" data-action="onboarding#back">Atrás</button><button class="btn-primary" type="button" data-action="onboarding#next">Continuar</button></div>
    </section>

    <section class="onboarding-step hidden" data-onboarding-target="step" data-step="destination">
        <p class="eyebrow">Destino principal</p><h1>¿Dónde estás destinado normalmente?</h1><p class="step-copy">Tu unidad de plantilla, aunque algunos días cubras otra.</p>
        {% include 'workforce/_searchable_picker.html.twig' with {picker_id: 'destination', label: 'Servicio o unidad principal', placeholder: 'Buscar unidad o servicio…', endpoint: '/api/workplaces/{workplace}/units', field_name: 'primary_destination_id', initial_value: draft and draft.primaryDestination ? draft.primaryDestination.selectionId : '', initial_label: draft and draft.primaryDestination ? draft.primaryDestination.name : '', allow_local: true, sheet_title: 'Selecciona tu destino'} %}
        <div class="step-actions"><button class="btn-ghost" type="button" data-action="onboarding#back">Atrás</button><button class="btn-primary" type="button" data-action="onboarding#next">Continuar</button></div>
    </section>

    <section class="onboarding-step hidden" data-onboarding-target="step" data-step="additional">
        <p class="eyebrow">Compatibilidad adicional · Opcional</p><h1>¿Puedes cambiar con otra unidad?</h1><p class="step-copy">Selecciona únicamente grupos con los que realmente puedas intercambiar turnos. Podrás modificarlo después.</p>
        <div class="primary-context"><span>Tu destino principal</span><strong data-onboarding-target="primaryContext">—</strong></div>
        {% include 'workforce/_searchable_picker.html.twig' with {picker_id: 'additional', label: 'También puedo cambiar con', placeholder: 'Buscar otra unidad…', endpoint: '/api/workplaces/{workplace}/units', field_name: 'additional_destination_ids', initial_value: additional_ids|join(','), initial_label: additional_names|join(', '), mode: 'multiple', allow_local: false, exclude_field: 'primary_destination_id', sheet_title: 'Unidades adicionales'} %}
        <div class="step-actions"><button class="btn-ghost" type="button" data-action="onboarding#back">Atrás</button><button class="btn-primary" type="button" data-onboarding-target="additionalButton" data-action="onboarding#next">Omitir por ahora</button></div>
    </section>

    <section class="onboarding-step hidden" data-onboarding-target="step" data-step="summary">
        <p class="eyebrow">Todo listo</p><h1>Tu puesto en Turnin</h1>
        <article class="profile-summary">
            <p class="text-xl font-bold" data-onboarding-target="summaryName"></p>
            <p class="text-lg font-semibold"><span data-onboarding-target="summaryCategory"></span> · <span data-onboarding-target="summaryDestination"></span></p>
            <p class="text-ink-muted" data-onboarding-target="summaryWorkplace"></p>
            <div class="hidden pt-3" data-onboarding-target="summaryAdditional"><p class="text-sm font-semibold">También puedes cambiar con</p><p class="text-ink-muted" data-onboarding-target="summaryAdditionalNames"></p></div>
        </article>
        <p class="alert-info">Eres de los primeros de tu grupo en Turnin.</p>
        <div class="step-actions"><button class="btn-ghost" type="button" data-action="onboarding#back">Atrás</button><button class="btn-primary" type="button" data-action="onboarding#finish">Entrar en Turnin</button></div>
    </section>
</main>
{% endblock %}
