{% extends 'base.html.twig' %}
{% block title %}Turnin — Responsable del equipo{% endblock %}
{% block body %}
<main class="supervisor-shell">
    {% if app.user %}{% include 'identity/_authenticated_header.html.twig' %}{% endif %}
    <section class="supervisor-card supervisor-card-muted" role="alert">
        <p class="supervisor-state">Responsable del equipo</p>
        <h1 class="text-2xl font-bold">{{ message }}</h1>
        <a class="btn-secondary btn-block" href="{{ path(app.user ? 'identity_app' : 'web_home') }}">Volver al inicio</a>
    </section>
</main>
{% endblock %}
