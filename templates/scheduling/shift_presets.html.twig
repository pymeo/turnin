{% extends 'base.html.twig' %}

{% block title %}Turnin — Mis turnos{% endblock %}

{% block body %}
{% set tones = {
    'amber': 'calendar-tone-amber', 'orange': 'calendar-tone-orange', 'teal': 'calendar-tone-teal',
    'blue': 'calendar-tone-blue', 'indigo': 'calendar-tone-indigo', 'violet': 'calendar-tone-violet',
    'rose': 'calendar-tone-rose', 'slate': 'calendar-tone-slate', 'emerald': 'calendar-tone-emerald', 'cyan': 'calendar-tone-cyan',
    'rest': 'calendar-tone-rest',
    'unknown': 'calendar-tone-unknown',
} %}
{% set fills = {
    'amber': 'shift-fill-amber', 'orange': 'shift-fill-orange', 'teal': 'shift-fill-teal',
    'blue': 'shift-fill-blue', 'indigo': 'shift-fill-indigo', 'violet': 'shift-fill-violet',
    'rose': 'shift-fill-rose', 'slate': 'shift-fill-slate', 'emerald': 'shift-fill-emerald', 'cyan': 'shift-fill-cyan',
} %}
<main class="page flex flex-col gap-5" data-controller="shift-presets" data-shift-presets-csrf-value="{{ csrfToken }}" data-shift-presets-assignment-value="{{ assignmentId }}">
    {% include 'identity/_authenticated_header.html.twig' %}

    <header class="flex flex-col gap-1">
        <a class="text-sm text-ink-muted no-underline" href="{{ path('scheduling_calendar', {assignment: assignmentId}) }}">‹ Calendario</a>
        <h1 class="text-2xl font-bold tracking-tight">Mis turnos</h1>
        <p class="text-ink-muted">
            Son los botones que usas para pintar tu calendario. Cambiar un horario aquí
            no altera los turnos que ya has guardado.
        </p>
    </header>

    <section class="flex flex-col gap-2" data-shift-presets-target="list">
        {% for preset in presets %}
            <article class="preset-row" data-active="{{ preset.active ? 'true' : 'false' }}" data-preset-id="{{ preset.id }}" data-name="{{ preset.name }}" data-abbreviation="{{ preset.abbreviation }}" data-start="{{ preset.start }}" data-end="{{ preset.end }}" data-kind="{{ preset.kind }}" data-color="{{ preset.colorKey }}" data-aliases="{{ preset.aliases|join(', ') }}">
                <span class="preset-mark {{ tones[preset.tone]|default('calendar-tone-unknown') }}" aria-hidden="true">{{ preset.abbreviation }}</span>
                <span class="flex min-w-0 flex-1 flex-col">
                    <span class="truncate font-semibold">{{ preset.name }}</span>
                    <span class="text-sm text-ink-muted">
                        {{ preset.start }} – {{ preset.end }}{% if preset.endsNextDay %} <span class="text-xs">(+1 día)</span>{% endif %}
                        {%- if not preset.active %} · retirado{% endif %}
                    </span>
                </span>
                <span class="flex shrink-0 items-center gap-1">
                    <button type="button" class="calendar-nav-button text-base" data-action="shift-presets#moveUp" aria-label="Subir {{ preset.name }}">↑</button>
                    <button type="button" class="btn-ghost px-3 text-sm" data-action="shift-presets#edit">Editar</button>
                    <button type="button" class="btn-ghost px-2 text-sm" data-action="shift-presets#duplicate">Duplicar</button>
                </span>
            </article>
        {% endfor %}
    </section>

    <button type="button" class="btn-secondary btn-block" data-action="shift-presets#create">＋ Crear un turno</button>

    <dialog class="sheet" data-controller="bottom-sheet" data-shift-presets-target="sheet" aria-labelledby="preset-sheet-title">
        <form class="sheet-inner" data-action="submit->shift-presets#submit">
            <span class="sheet-handle" aria-hidden="true"></span>
            <div class="sheet-header">
                <h2 id="preset-sheet-title" data-shift-presets-target="sheetTitle">Editar turno</h2>
                <button type="button" class="picker-close" data-action="bottom-sheet#close" aria-label="Cerrar">×</button>
            </div>

            <div class="preset-preview" aria-hidden="true">
                <span class="preset-preview-cell {{ tones['amber'] }}" data-shift-presets-target="previewCell">
                    <span class="text-[0.72rem] leading-none font-black" data-shift-presets-target="previewCode">M</span>
                </span>
                <span class="flex min-w-0 flex-col">
                    <span class="truncate font-semibold" data-shift-presets-target="previewName">Mañana</span>
                    <span class="text-sm text-ink-muted" data-shift-presets-target="previewHours">08:00 – 15:00</span>
                </span>
            </div>

            <label class="field"><span class="field-label">¿Qué quieres crear?</span>
                <select class="input" data-shift-presets-target="mode" data-action="shift-presets#derive">
                    <option value="custom">Horario personalizado</option><option value="12h">Turno de 12 horas</option><option value="part">Parte de otro turno</option>
                </select>
            </label>
            <div class="hidden grid grid-cols-2 gap-3" data-shift-presets-target="partOptions">
                <label class="field"><span class="field-label">¿De cuál?</span><select class="input" data-shift-presets-target="base" data-action="shift-presets#derive">{% for preset in presets %}<option value="{{ preset.start }}|{{ preset.end }}">{{ preset.name }} · {{ preset.start }}–{{ preset.end }}</option>{% endfor %}</select></label>
                <label class="field"><span class="field-label">Parte</span><select class="input" data-shift-presets-target="slice" data-action="shift-presets#derive"><option value="0/2">Primera mitad</option><option value="1/2">Segunda mitad</option><option value="0/3">Primer tercio</option><option value="1/3">Segundo tercio</option><option value="2/3">Último tercio</option></select></label>
            </div>

            <label class="field">
                <span class="field-label">Nombre</span>
                <input class="input" name="name" maxlength="40" required data-shift-presets-target="name">
            </label>
            <div class="grid grid-cols-[5.5rem_1fr] gap-3">
                <label class="field">
                    <span class="field-label">Abreviatura</span>
                    <input class="input" name="abbreviation" maxlength="3" required data-shift-presets-target="abbreviation">
                </label>
                <label class="field">
                    <span class="field-label">Tipo</span>
                    <select class="input" name="kind" data-shift-presets-target="kind">
                        <option value="morning">Mañana</option>
                        <option value="evening">Tarde</option>
                        <option value="night">Noche</option>
                        <option value="long_day">12 h día</option>
                        <option value="long_night">12 h noche</option>
                        <option value="on_call">Guardia</option>
                        <option value="other">Otro</option>
                    </select>
                </label>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <label class="field">
                    <span class="field-label">Empieza</span>
                    <input class="input" type="time" name="start" required data-shift-presets-target="start" data-action="shift-presets#derive">
                </label>
                <label class="field">
                    <span class="field-label">Termina</span>
                    <input class="input" type="time" name="end" required data-shift-presets-target="end">
                </label>
            </div>
            <p class="text-sm text-ink-muted">Si termina antes de empezar, entendemos que acaba al día siguiente.</p>
            <div class="field">
                <span class="field-label" id="preset-color-label">Color</span>
                <div class="shift-swatches" role="radiogroup" aria-labelledby="preset-color-label" data-shift-presets-target="colors">
                    {% for color in colors %}
                        <button type="button"
                                class="shift-swatch {{ fills[color.key]|default('shift-fill-slate') }}"
                                role="radio"
                                aria-checked="false"
                                aria-label="{{ color.label }}"
                                title="{{ color.label }}"
                                data-color-key="{{ color.key }}"
                                data-action="click->shift-presets#chooseColor keydown->shift-presets#moveColor">
                            <span class="shift-swatch-check" aria-hidden="true">✓</span>
                        </button>
                    {% endfor %}
                </div>
                <input type="hidden" name="colorKey" data-shift-presets-target="color" value="amber">
                <span class="text-sm text-ink-muted">
                    <span data-shift-presets-target="colorName">Ámbar</span>. El color es visual; las horas siguen siendo la verdad del turno.
                </span>
            </div>
            <label class="field">
                <span class="field-label">Cómo lo llamas al dictar</span>
                <input class="input" name="aliases" data-shift-presets-target="aliases" placeholder="guardia, g, 24 horas">
                <span class="text-sm text-ink-muted">Separado por comas. Lo usamos para entenderte cuando dictas.</span>
            </label>

            <p class="field-error hidden" data-shift-presets-target="error" role="alert"></p>

            <div class="sheet-actions">
                <button type="submit" class="btn-primary btn-block">Guardar turno</button>
                <button type="button" class="btn-ghost btn-block hidden" data-action="shift-presets#deactivate" data-shift-presets-target="deactivate">
                    Retirar este turno
                </button>
            </div>
        </form>
    </dialog>
</main>
{% endblock %}
