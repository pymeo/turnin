{% extends 'base.html.twig' %}

{% block title %}Turnin — Mi calendario{% endblock %}
{% block description %}Tu cuadrante de turnos en Turnin: píntalo, repite tu patrón o díctalo.{% endblock %}

{% block body %}
{% set tones = {
    'amber': 'calendar-tone-amber', 'orange': 'calendar-tone-orange', 'teal': 'calendar-tone-teal',
    'blue': 'calendar-tone-blue', 'indigo': 'calendar-tone-indigo', 'violet': 'calendar-tone-violet',
    'rose': 'calendar-tone-rose', 'slate': 'calendar-tone-slate', 'emerald': 'calendar-tone-emerald', 'cyan': 'calendar-tone-cyan',
    'rest': 'calendar-tone-rest',
    'unknown': 'calendar-tone-unknown',
} %}
<main class="calendar-shell"
      data-controller="calendar{% if not combined %} calendar-paint schedule-draft{% endif %}"
      data-calendar-month-value="{{ month.month }}"
      data-calendar-today-value="{{ month.today }}"
      data-calendar-csrf-value="{{ csrfToken }}"
      data-calendar-assignment-value="{{ selectedAssignment ? selectedAssignment.assignmentId : '' }}"
      data-calendar-view-value="{{ combined ? 'all' : 'assignment' }}"
      data-schedule-draft-csrf-value="{{ csrfToken }}">

    {% include 'identity/_authenticated_header.html.twig' %}

    <div class="flex justify-end"><a class="btn-ghost text-sm" href="{{ path('scheduling_calendar_integrations') }}">⋯ Integraciones</a></div>

    <details class="calendar-filters">
        <summary>Mostrar calendarios</summary>
        <label><input type="checkbox" checked data-calendar-target="filterWork" data-action="calendar#filterChanged"> Turnos</label>
        <label><input type="checkbox" checked data-calendar-target="filterPersonal" data-action="calendar#filterChanged"> Eventos personales</label>
    </details>

    <section class="flex flex-col gap-1" aria-label="Calendario seleccionado">
        {% if assignments|length > 1 %}
            <details class="rounded-xl border border-line bg-surface px-3 py-2">
                <summary class="cursor-pointer font-semibold">{{ combined ? 'Todos mis trabajos' : selectedAssignment.shortLabel }}</summary>
                <nav class="mt-2 flex flex-col gap-1" aria-label="Mis calendarios">
                    {% for assignment in assignments %}
                        <a class="btn-ghost justify-start px-2 text-sm" href="{{ path('scheduling_calendar', {assignment: assignment.assignmentId, month: month.month}) }}">{{ assignment.shortLabel }}{% if assignment.primary %} · Principal{% endif %}</a>
                    {% endfor %}
                    <a class="btn-ghost justify-start px-2 text-sm" href="{{ path('scheduling_calendar', {view: 'all', month: month.month}) }}">Todos mis trabajos</a>
                    <a class="btn-ghost justify-start px-2 text-sm" href="{{ path('workforce_onboarding', {mode: 'add'}) }}">＋ Añadir lugar de trabajo</a>
                </nav>
            </details>
        {% elseif selectedAssignment %}
            <strong>{{ selectedAssignment.workplaceName }}</strong>
            {% if selectedAssignment.destinationName %}<span class="text-sm text-ink-muted">{{ selectedAssignment.destinationName }}</span>{% endif %}
        {% endif %}
    </section>

    {% if not combined and presets is empty %}
        <section class="empty-state">
            <p class="text-lg font-semibold text-ink">Aún no has configurado los turnos de este centro</p>
            <p>Empieza con unos horarios habituales o copia otro calendario. Podrás cambiarlos después sin alterar el histórico.</p>
            <button class="btn-primary" type="button" data-action="calendar#seedPresets">Usar turnos habituales</button>
            {% for assignment in assignments %}{% if assignment.assignmentId != selectedAssignment.assignmentId %}<button class="btn-secondary" type="button" data-assignment-id="{{ assignment.assignmentId }}" data-action="calendar#copyPresets">Copiar de {{ assignment.workplaceName }}</button>{% endif %}{% endfor %}
            <a class="btn-ghost" href="{{ path('scheduling_shift_presets', {assignment: selectedAssignment.assignmentId}) }}">Configurar</a>
        </section>
    {% endif %}

    {% if not combined and presets is not empty and not month.hasAnyRoster %}
        <section class="card flex flex-col gap-3">
            <span><h2 class="text-lg font-semibold">Tus turnos habituales</h2><p class="text-sm text-ink-muted">Puedes usarlos ya y ajustar sus horarios cuando quieras.</p></span>
            <div class="grid gap-2 sm:grid-cols-3">{% for preset in presets|filter(preset => preset.active) %}<span class="flex items-center gap-2"><b class="preset-mark {{ tones[preset.tone]|default('calendar-tone-unknown') }}">{{ preset.abbreviation }}</b><span><strong>{{ preset.name }}</strong><br><small>{{ preset.start }} – {{ preset.end }}</small></span></span>{% endfor %}</div>
            <a class="btn-secondary self-start" href="{{ path('scheduling_shift_presets', {assignment: selectedAssignment.assignmentId}) }}">Ajustar horarios</a>
        </section>
    {% endif %}

    {% if nextShift %}
        <section class="next-shift-card" aria-label="Próximo turno">
            <span class="next-shift-mark {{ tones[nextShift.tone]|default('calendar-tone-unknown') }}" aria-hidden="true">{{ nextShift.label|slice(0, 1)|upper }}</span>
            <span class="flex min-w-0 flex-col">
                <span class="text-xs font-semibold tracking-wide text-ink-muted uppercase">Próximo turno</span>
                <span class="truncate text-base font-semibold">{{ nextShift.when }} · {{ nextShift.label }}</span>
                <span class="text-sm text-ink-muted">{{ nextShift.hours }}{% if nextShift.endsNextDay %} <span class="text-xs">(termina al día siguiente)</span>{% endif %}</span>
            </span>
        </section>
    {% endif %}

    <header class="calendar-header">
        <button type="button" class="calendar-nav-button" data-action="calendar#previous" aria-label="Mes anterior">‹</button>
        <h2 data-calendar-target="title" aria-live="polite">{{ month.title }}</h2>
        <span class="flex items-center gap-1">
            <button type="button" class="btn-ghost px-3 text-sm" data-action="calendar#goToToday">Hoy</button>
            <button type="button" class="calendar-nav-button" data-action="calendar#next" aria-label="Mes siguiente">›</button>
        </span>
    </header>

    <div class="calendar-weekdays" aria-hidden="true">
        {% for initial in weekdays %}<span>{{ initial }}</span>{% endfor %}
    </div>

    {% include combined ? 'scheduling/_combined_month_grid.html.twig' : 'scheduling/_month_grid.html.twig' %}
    {% include combined ? 'scheduling/_combined_month_summary.html.twig' : 'scheduling/_month_summary.html.twig' %}

    {% if not combined and not month.hasAnyRoster %}
        <section class="empty-state" data-calendar-target="emptyState">
            <p class="text-lg font-semibold text-ink">Añade tu cuadrante</p>
            <p>Pinta tus turnos, usa tu patrón o dínoslo por voz. Se tarda menos de un minuto.</p>
            <button type="button" class="btn-primary" data-action="calendar#openAdd">Añadir turnos</button>
        </section>
    {% endif %}

    {# A repeating rotation we spotted in what the worker already entered. Only
       ever shown for an exact repetition over at least two whole cycles. #}
    <section class="calendar-insight hidden flex-col gap-1" data-calendar-target="detection" aria-live="polite">
        <span data-calendar-target="detectionText"></span>
        <button type="button" class="btn-ghost self-start px-0 text-sm" data-action="calendar#repeatDetectedPattern">Repetir automáticamente</button>
    </section>

    <div class="calendar-dock">
        {% if not combined %}{% include 'scheduling/_paint_bar.html.twig' %}{% endif %}
        <button type="button" class="btn-primary btn-block" data-calendar-target="addButton" data-action="calendar#openAdd">
            <span aria-hidden="true">＋</span> Añadir turnos
        </button>
    </div>

    {% include 'scheduling/_sheets.html.twig' %}
</main>
{% endblock %}
