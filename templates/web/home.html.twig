{% extends 'base.html.twig' %}

{% block title %}TURNIN — Cambia turnos. Sigue avanzando.{% endblock %}

{% block body %}
<main class="marketing-shell" data-controller="install">
    <section class="marketing-copy">
        <img class="brand-lockup" src="/brand/turnin-logo.svg" alt="TURNIN" width="230" height="64">
        <p class="eyebrow">Más flexibilidad para quienes siempre están ahí</p>
        <h1 class="marketing-title">Tus turnos deberían adaptarse a tu vida.</h1>
        <p class="max-w-lg text-lg leading-relaxed text-ink-muted">Encuentra compañeros compatibles y organiza tus turnos de una forma mucho más sencilla.</p>
        <div class="grid w-full gap-3 sm:w-auto sm:grid-cols-2">
            {# Google is the primary way in, so the landing offers it directly
               instead of making people find it one screen deeper. Same partial
               as /login and /register: one entry point, one URL to register in
               Google Cloud. #}
            <div class="sm:col-span-2">{% include 'identity/_google_button.html.twig' %}</div>
            <a href="{{ path('identity_register') }}" class="btn-secondary">Empezar</a>
            <a href="{{ path('identity_login') }}" class="btn-secondary">Iniciar sesión</a>
            <button type="button" class="btn-secondary sm:col-span-2" data-install-target="button" data-action="install#install" hidden>Instalar TURNIN</button>
        </div>
        <ol class="mt-3 grid gap-3 sm:grid-cols-3" aria-label="Cómo funciona">
            <li class="card"><strong>1. Tu turno</strong><p class="mt-1 text-sm text-ink-muted">Dices cuál quieres librar.</p></li>
            <li class="card"><strong>2. Tu equipo</strong><p class="mt-1 text-sm text-ink-muted">Turnin busca a alguien compatible.</p></li>
            <li class="card"><strong>3. Más libertad</strong><p class="mt-1 text-sm text-ink-muted">Ves posibilidades sin perseguir al grupo.</p></li>
        </ol>
    </section>
    <figure class="marketing-visual"><img src="/brand/turnin-workers.svg" alt="Profesionales de sanidad, policía, emergencias y servicios unidos como equipo" width="920" height="380"><figcaption class="mt-2 text-center font-semibold text-[var(--turnin-petroleum)]">Profesionales que hacen que todo funcione.</figcaption></figure>
</main>
{% endblock %}
