{% extends 'base.html.twig' %}

{% block title %}Turnin — Mis intercambios{% endblock %}

{% block body %}
<main class="changes-shell">
    {% include 'identity/_authenticated_header.html.twig' %}
    <header class="changes-heading">
        <a class="text-sm text-ink-muted no-underline" href="{{ path('swap_changes') }}">‹ Cambios</a>
        <h1>Mis intercambios</h1>
    </header>

    {% if app.request.query.get('enviada') %}<p class="alert alert-success" role="status">Opciones enviadas. Te avisaremos cuando elija una.</p>{% endif %}
    {% if app.request.query.get('hecho') %}<p class="alert alert-success" role="status">Intercambio confirmado.</p>{% endif %}

    {% for proposal in proposals %}
        <article class="proposal-card" data-proposal-id="{{ proposal.proposalId }}" data-status="{{ proposal.status }}">
            <p class="changes-kicker">{{ proposal.incoming ? proposal.otherName ~ ' te hace el turno' : 'Le haces el turno a ' ~ proposal.otherName }}</p>
            <div class="proposal-side">
                <strong class="swap-card-date">{{ proposal.requestedHeadline|upper }}</strong>
                <span class="shift-card-hours">{{ proposal.requestedHours }}</span>
                <span class="shift-card-duration">{{ proposal.requestedDuration|upper }}</span>
            </div>
            {% if proposal.chosenHeadline %}
                <p class="proposal-swap-mark" aria-hidden="true">↕</p>
                <div class="proposal-side">
                    <span class="trade-side-label">A cambio</span>
                    <strong class="swap-card-date">{{ proposal.chosenHeadline|upper }}</strong>
                    <span class="shift-card-hours">{{ proposal.chosenHours }}</span>
                </div>
            {% elseif proposal.optionCount %}
                <p class="proposal-status">{{ proposal.optionCount }} {{ proposal.optionCount == 1 ? 'turno ofrecido a cambio' : 'turnos ofrecidos a cambio' }}</p>
            {% endif %}
            <p class="proposal-status">{{ proposal.statusLabel }}</p>
            {% if proposal.decidable %}
                <a class="btn-primary btn-block" href="{{ path('swap_proposal_decision', {proposalId: proposal.proposalId}) }}">Elegir turno</a>
            {% elseif proposal.status == 'pending' and not proposal.incoming %}
                <form method="post" action="{{ path('swap_proposal_decide', {proposalId: proposal.proposalId, decision: 'withdraw'}) }}">
                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                    <button class="btn-ghost btn-block" type="submit">Retirar</button>
                </form>
            {% elseif proposal.status in ['pending_approval', 'executed', 'accepted', 'approval_rejected', 'expired'] and proposal.chosenHeadline %}
                <a class="btn-secondary btn-block" href="{{ path('swap_agreement', {proposalId: proposal.proposalId}) }}">Ver cambio</a>
            {% else %}
                <a class="btn-secondary btn-block" href="{{ path('swap_proposal_decision', {proposalId: proposal.proposalId}) }}">Ver detalle</a>
            {% endif %}
        </article>
    {% else %}
        <div class="empty-state"><strong>Todavía no hay intercambios.</strong><span>Cuando alguien se ofrezca a hacer tu turno, o tú te ofrezcas a hacer el suyo, aparecerá aquí.</span></div>
    {% endfor %}
</main>
{% endblock %}
