{% extends 'base.html.twig' %}

{% block title %}Turnin — Turnos de compañeros{% endblock %}

{% block body %}
<main class="changes-shell">
    {% include 'identity/_authenticated_header.html.twig' %}
    <header class="changes-heading">
        <a class="text-sm text-ink-muted no-underline" href="{{ path('swap_changes') }}">‹ Cambios</a>
        <h1>Turnos de compañeros</h1>
        <p>Solo ves turnos de gente con la que puedes cambiar. Te decimos cuáles puedes hacer tú.</p>
    </header>

    {# Already ordered by colleague and then by date, so "¿qué días está
       intentando librar David?" is one glance and not a scan of the list. #}
    {% set shownAuthor = '' %}
    <div class="colleague-list">
        {% for request in openRequests %}
            {% if request.authorName != shownAuthor %}
                <h2 class="colleague-name">{{ request.authorName }}</h2>
                {% set shownAuthor = request.authorName %}
            {% endif %}
            {% include 'swap/_colleague_shift_card.html.twig' with {request: request} only %}
        {% else %}
            <div class="empty-state"><strong>Ahora mismo no hay turnos de compañeros.</strong><span>Cuando alguien de tu grupo quiera librar un turno lo verás aquí.</span></div>
        {% endfor %}
    </div>
</main>
{% endblock %}
