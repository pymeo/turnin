{% extends 'base.html.twig' %}
{% block title %}Turnin — Área de responsable{% endblock %}
{% block body %}
<main class="supervisor-shell" data-changes-csrf-value="{{ csrfToken }}">
    {% include 'identity/_authenticated_header.html.twig' %}
    <header>
        <a class="text-sm text-ink-muted no-underline" href="{{ path('identity_app') }}">‹ Inicio</a>
        <h1 class="text-3xl font-bold">Cambios pendientes</h1>
        <p class="text-ink-muted">Acuerdos de tus equipos que esperan tu revisión.</p>
    </header>
    {% if outcome == 'aprobado' %}
        <p class="alert-success" role="status">Cambio aprobado. Se ha registrado en los calendarios.</p>
    {% elseif outcome == 'rechazado' %}
        <p class="alert-info" role="status">Cambio rechazado. Los dos compañeros han sido avisados.</p>
    {% endif %}
    {% for agreement in dashboard.pending %}
        <article class="supervisor-card supervisor-card-pending" data-testid="supervisor-pending-change">
            <p class="supervisor-state">{{ agreement.requestedLeg.location }}</p>
            <p class="text-xl font-bold">{{ agreement.requestOwnerName }} ↔ {{ agreement.proposerName }}</p>
            <div class="flex flex-col gap-1">
                <p><span class="text-ink-muted">{{ agreement.requestedLeg.eyebrow|lower|capitalize }}:</span> <strong>{{ agreement.requestedLeg.date }}</strong>{% for segment in agreement.requestedLeg.segments %} · {{ segment.hours }}{% endfor %}</p>
                {% if agreement.returnLeg %}
                    <p><span class="text-ink-muted">{{ agreement.returnLeg.eyebrow|lower|capitalize }}:</span> <strong>{{ agreement.returnLeg.date }}</strong>{% for segment in agreement.returnLeg.segments %} · {{ segment.hours }}{% endfor %}</p>
                {% endif %}
                <p class="text-sm text-ink-muted">{{ agreement.difference }} Acordado el {{ agreement.reachedAt }} · Ref. {{ agreement.reference }}</p>
            </div>
            <div class="supervisor-actions">
                <form method="post" action="{{ path('swap_supervisor_review', {proposalId: agreement.proposalId, decision: 'approve'}) }}" class="flex">
                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                    <button class="btn-primary btn-block" type="submit">Aprobar</button>
                </form>
                <form method="post" action="{{ path('swap_supervisor_review', {proposalId: agreement.proposalId, decision: 'reject'}) }}" class="flex">
                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                    <button class="btn-secondary btn-block" type="submit">Rechazar</button>
                </form>
            </div>
        </article>
    {% else %}
        <div class="empty-state"><strong>No tienes cambios pendientes.</strong><span>Te avisaremos cuando tu equipo acuerde uno.</span></div>
    {% endfor %}
    <a class="btn-ghost btn-block" href="{{ path('workforce_team') }}">Ver equipo</a>
</main>
{% endblock %}
