{% extends 'base.html.twig' %}

{% block title %}Turnin — Mis turnos publicados{% endblock %}

{% block body %}
<main class="changes-shell" data-controller="changes" data-changes-csrf-value="{{ csrfToken }}">
    {% include 'identity/_authenticated_header.html.twig' %}
    <header class="changes-heading">
        <a class="text-sm text-ink-muted no-underline" href="{{ path('swap_changes') }}">‹ Cambios</a>
        <h1>Mis turnos publicados</h1>
        <p>Los turnos que quieres librar y quién se ha ofrecido.</p>
    </header>

    <section class="activity-section" aria-labelledby="release-title">
        <h2 id="release-title" class="sr-only">Turnos que quiero librar</h2>
        {% for request in myRequests %}
            {% set answers = proposals|filter(proposal => proposal.incoming and proposal.decidable and proposal.requestId == request.requestId) %}
            <article class="activity-card" data-request-id="{{ request.requestId }}">
                <p class="swap-card-date">{{ request.dateHeadline|upper }}</p>
                <p class="shift-card-hours">{{ request.hours }}</p>
                <p class="shift-card-duration">{{ request.durationLabel|upper }}</p>
                <h3>{{ request.shiftLabel }}</h3>
                <p class="text-sm"><strong>{{ request.groupLabel }}</strong><br><span class="text-ink-muted">{{ request.workplaceName }}</span></p>
                <p class="activity-status">
                    {% if answers|length %}
                        <strong>{{ answers|length }} {{ answers|length == 1 ? 'compañero se ofrece' : 'compañeros se ofrecen' }}</strong>
                    {% else %}
                        Todavía nadie se ha ofrecido.
                    {% endif %}
                </p>
                <div class="activity-actions">
                    {% if answers|length %}
                        <a class="btn-primary" href="{{ path('swap_proposal_decision', {proposalId: answers[0].proposalId}) }}">Ver y elegir</a>
                    {% else %}
                        <a class="btn-secondary" href="{{ path('scheduling_calendar', {month: request.date|slice(0, 7)}) }}">Ver en el calendario</a>
                    {% endif %}
                    <button class="btn-ghost" type="button" data-action="changes#cancelRequest" data-request-id="{{ request.requestId }}">Dejar de buscar</button>
                </div>
            </article>
        {% else %}
            <div class="empty-state"><strong>No estás intentando librar ningún turno.</strong><a class="btn-primary" href="{{ path('swap_changes', {flow: 'release'}) }}">Quiero librar un turno</a></div>
        {% endfor %}
    </section>

    <a class="btn-secondary btn-block" href="{{ path('swap_proposals') }}">Mis intercambios</a>

    <section class="activity-section" aria-labelledby="availability-title">
        <h2 id="availability-title" class="changes-section-title">Puedo trabajar</h2>
        {% for day in myAvailability %}
            <article class="activity-card" data-availability-date="{{ day.date }}">
                <p class="swap-card-date">{{ day.dateHeadline|upper }}</p>
                <h3>{{ day.shiftLabels|join(' · ') }}</h3>
                {% for place in day.places %}
                    <p><strong>{{ place.workplaceName }}</strong><br><span class="text-ink-muted">{{ place.destinations|join(' · ') }}</span></p>
                {% endfor %}
                <a class="btn-secondary self-start" href="{{ path('swap_changes', {edit: day.date}) }}">Editar</a>
            </article>
        {% else %}
            <div class="empty-state">
                <strong>¿Te vendría bien trabajar algún día?</strong>
                <span>Indica cuándo puedes y te enseñaremos turnos compatibles.</span>
                <a class="btn-primary" href="{{ path('swap_changes', {flow: 'availability'}) }}">Añadir disponibilidad</a>
            </div>
        {% endfor %}
    </section>

    <p class="field-error hidden" data-changes-target="error" role="alert"></p>
</main>
{% endblock %}
