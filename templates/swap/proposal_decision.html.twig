{% extends 'base.html.twig' %}

{% block title %}Turnin — {{ decision.otherName }} te hace un turno{% endblock %}

{% block body %}
<main class="changes-shell">
    {% include 'identity/_authenticated_header.html.twig' %}
    <header class="changes-heading">
        <a class="text-sm text-ink-muted no-underline" href="{{ path('swap_proposals') }}">‹ Mis intercambios</a>
        <h1>{{ decision.otherName }} te hace el turno</h1>
    </header>

    <section class="composer-take" aria-label="Turno que te hace">
        <p class="trade-side-label">{{ decision.otherName }} trabajaría</p>
        <p class="swap-card-date">{{ decision.requestedHeadline|upper }}</p>
        <p class="shift-card-hours">{{ decision.requestedHours }}</p>
        <p class="composer-take-duration">{{ decision.requestedDuration|upper }}</p>
        <p class="composer-take-place"><strong>{{ decision.requestedLabel }}</strong><br>{{ decision.requestedGroupLabel }}</p>
    </section>

    {% if decision.decidable %}
        <form method="post" action="{{ path('swap_proposal_accept', {proposalId: decision.proposalId}) }}" class="flex flex-col gap-4">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <h2 class="changes-section-title">Elige qué turno puedes hacerle tú</h2>
            <div class="composer-list">
                {% for option in decision.options %}
                    {% if option.canDoIt %}
                        <label class="trade-option">
                            <input type="radio" name="optionId" value="{{ option.optionId }}" required>
                            <span class="trade-option-body">
                                <span class="trade-option-add"><b aria-hidden="true">+</b> Puedes hacer este turno</span>
                                <span class="trade-option-picked"><b aria-hidden="true">✓</b> Elegido</span>
                                <strong class="swap-card-date">{{ option.dateHeadline|upper }}</strong>
                                <span class="shift-card-hours">{{ option.hours }}{% if option.endsNextDay %} <small>termina al día siguiente</small>{% endif %}</span>
                                <span class="shift-card-duration">{{ option.durationLabel|upper }}</span>
                                <strong>{{ option.shiftLabel }}</strong>
                                {% if option.obstacleMessage %}<span class="compatibility-note"><span aria-hidden="true">⚠</span> {{ option.obstacleMessage }}</span>{% endif %}
                            </span>
                        </label>
                    {% else %}
                        <div class="trade-option-blocked">
                            <span class="trade-option-unavailable"><b aria-hidden="true">×</b> Ya no puedes hacer este turno</span>
                            <strong class="swap-card-date">{{ option.dateHeadline|upper }}</strong>
                            <span class="shift-card-hours">{{ option.hours }}</span>
                            <strong>{{ option.shiftLabel }}</strong>
                            <span class="composer-blocked-reason">{{ option.obstacleMessage }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            <button class="btn-primary btn-block" type="submit">Confirmar intercambio</button>
        </form>
        <form method="post" action="{{ path('swap_proposal_decide', {proposalId: decision.proposalId, decision: 'reject'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <button class="btn-ghost btn-block" type="submit">No me viene bien ninguno</button>
        </form>
    {% else %}
        <section class="flex flex-col gap-3">
            <h2 class="changes-section-title">{{ decision.incoming ? 'Turnos que te ofrecía' : 'Turnos que ofreciste' }}</h2>
            <div class="composer-list">
                {% for option in decision.options %}
                    <div class="trade-option-blocked{{ decision.chosenOptionId == option.optionId ? ' trade-option-chosen' : '' }}">
                        <strong class="swap-card-date">{{ option.dateHeadline|upper }}</strong>
                        <span class="shift-card-hours">{{ option.hours }}</span>
                        <strong>{{ option.shiftLabel }}</strong>
                        {% if decision.chosenOptionId == option.optionId %}<span class="verdict verdict-yes">Este es el elegido</span>{% endif %}
                    </div>
                {% endfor %}
            </div>
            {% if decision.requiresApproval %}
                <p class="alert alert-info" role="status"><strong>Intercambio acordado · Pendiente de aprobación.</strong></p>
            {% endif %}
        </section>
    {% endif %}
</main>
{% endblock %}
