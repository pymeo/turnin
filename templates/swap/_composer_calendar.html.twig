{# Four weeks of my own rota, with the colleague's verdict on each shift.

   A blank cell would read as "libre", and "libre" and "todavía no lo he
   rellenado" are different answers — so every day says which of the three it is
   in text, not only in colour. A shift the colleague cannot work stays on the
   calendar with the reason: removing it would remove the context the calendar
   exists to give.

   Parameters
     weeks           list<SwapComposerWeekView>
     interactive     bool   offerable days become buttons (default false)
     selectedKeys    list<string> what is ticked right now (default [])
     highlightDate   string the day I would be covering (default '')
     highlightLabel  string what to write in that cell (default '')

   Nothing here knows about proposals, so any screen that shows a rota can pass
   interactive = false and reuse it. #}
{% set interactive = interactive|default(false) %}
{% set selectedKeys = selectedKeys|default([]) %}
{% set highlightDate = highlightDate|default('') %}
<div class="shift-calendar">
    <div class="shift-calendar-weekdays" aria-hidden="true"><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
    {% for week in weeks %}
        <div class="shift-calendar-week" aria-label="Semana del {{ week.label }}">
            {% for day in week.days %}
                {% set firstShift = day.shifts|first %}
                {% set isHighlight = highlightDate == day.date %}
                {% set state = isHighlight
                    ? (day.shifts|length ? (day.isSelectable ? 'combined-offerable' : 'combined-blocked') : 'incoming')
                    : (day.shifts|length ? (day.isSelectable ? 'offerable' : 'blocked') : (day.isRestDay ? 'rest' : 'unknown')) %}
                {% set offerable = interactive and day.isSelectable %}
                {% set blocked = (day.shifts|length and not day.isSelectable) ? firstShift.blockedReason : '' %}
                {% set tag = interactive and (offerable or blocked) ? 'button' : 'div' %}
                <{{ tag }}{% if tag == 'button' %} type="button" data-action="swap-composer#pick"{% endif %}
                        class="shift-day"
                        data-swap-composer-target="cell"
                        data-date="{{ day.date }}"
                        data-state="{{ state }}"
                        {% if day.shifts|length %}data-tone="{{ firstShift.tone }}"{% endif %}
                        data-state-label="{{ isHighlight ? (day.shifts|length ? 'Tú haces el suyo; ' ~ day.stateLabel|lower : 'Lo harías tú') : day.stateLabel }}"
                        data-headline="{{ day.dateCompact }}"
                        data-selectable="{{ offerable ? 'true' : 'false' }}"
                        data-shift-count="{{ day.shifts|length }}"
                        {% if day.selectableKey and offerable %}data-shift-key="{{ day.selectableKey }}"{% endif %}
                        {% if blocked %}data-blocked="{{ blocked }}"{% endif %}
                        data-today="{{ day.isToday ? 'true' : 'false' }}"
                        data-past="{{ day.isPast ? 'true' : 'false' }}"
                        {% if offerable %}aria-pressed="{{ day.selectableKey in selectedKeys ? 'true' : 'false' }}"{% endif %}
                        aria-label="{{ isHighlight ? day.ariaLabel ~ '. Este es el turno que harías tú' : day.ariaLabel }}">
                    <span class="shift-day-number">{{ day.dayNumber }}</span>
                    <span class="shift-day-weekday" aria-hidden="true">{{ day.weekday }}</span>
                    {% if isHighlight %}
                        <span class="shift-day-status" aria-hidden="true"><b>→</b> TÚ HACES</span>
                        <span class="shift-day-token">{{ highlightLabel }}</span>
                        {% if day.shifts|length %}
                            <span class="shift-day-status shift-day-status-own" data-swap-composer-target="cellStatus"><b>{{ day.isSelectable ? '+' : '×' }}</b> {{ day.isSelectable ? 'PUEDE' : 'NO PUEDE' }}</span>
                            <span class="shift-day-sub">Tu turno · {{ firstShift.hours }}</span>
                        {% endif %}
                    {% elseif day.shifts|length > 1 %}
                        <span class="shift-day-status" data-swap-composer-target="cellStatus"><b>{{ day.isSelectable ? '+' : '×' }}</b> {{ day.isSelectable ? 'PUEDE' : 'NO PUEDE' }}</span>
                        <span class="shift-day-token">{{ day.shifts|length }} turnos</span>
                    {% elseif day.shifts|length %}
                        <span class="shift-day-status" data-swap-composer-target="cellStatus"><b>{{ day.isSelectable ? '+' : '×' }}</b> {{ day.isSelectable ? 'PUEDE' : 'NO PUEDE' }}</span>
                        <span class="shift-day-token">{{ firstShift.durationLabel }}</span>
                        <span class="shift-day-sub">{{ firstShift.hours }}</span>
                    {% elseif day.isRestDay %}
                        <span class="shift-day-token">Libre</span>
                    {% else %}
                        <span class="shift-day-token">Sin datos</span>
                    {% endif %}
                    {% if firstShift and firstShift.compatibilityNote %}<span class="shift-day-advisory" title="{{ firstShift.compatibilityNote }}" aria-label="Aviso informativo">⚠</span>{% endif %}
                    {% if day.isRecommended %}<span class="shift-day-badge" title="Buena opción">★</span>{% endif %}
                </{{ tag }}>
            {% endfor %}
        </div>
    {% endfor %}
</div>
