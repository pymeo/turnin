{# The list alternative to the calendar, and the only place the checkboxes live.

   Both views drive this same group of inputs, so choosing from the calendar and
   choosing from the list post exactly the same thing. A shift the colleague
   cannot do stays here with its reason rather than disappearing.

   Parameters: shifts, selectedKeys, authorName #}
<div class="composer-list">
    {% for shift in shifts %}
        {% if shift.selectable %}
            <label class="trade-option"
                   data-swap-composer-target="option"
                   data-date="{{ shift.date }}"
                   data-shift-key="{{ shift.key }}"
                   data-headline="{{ shift.dateHeadline }}"
                   data-hours="{{ shift.hours }}"
                   data-duration="{{ shift.durationLabel }}"
                   data-shift-label="{{ shift.shiftLabel }}"
                   {% if shift.compatibilityNote %}data-compatibility-note="{{ shift.compatibilityNote }}"{% endif %}
                   {% if shift.recommendation %}data-recommendation="{{ shift.recommendation }}"{% endif %}>
                <input type="checkbox" name="offeredShifts[]" value="{{ shift.key }}" data-action="swap-composer#sync"{{ shift.key in selectedKeys ? ' checked' : '' }}>
                <span class="trade-option-body">
                    <span class="trade-option-add"><b aria-hidden="true">+</b> {{ authorName }} puede hacerlo</span>
                    <span class="trade-option-picked"><b aria-hidden="true">✓</b> Elegido</span>
                    <strong class="swap-card-date">{{ shift.dateHeadline|upper }}</strong>
                    <span class="shift-card-hours">{{ shift.hours }}{% if shift.endsNextDay %} <small>termina al día siguiente</small>{% endif %}</span>
                    <span class="shift-card-duration">{{ shift.durationLabel|upper }}</span>
                    <strong>{{ shift.shiftLabel }}</strong>
                    {% if shift.compatibilityNote %}<span class="compatibility-note"><span aria-hidden="true">⚠</span> {{ shift.compatibilityNote }}</span>{% endif %}
                    {% if shift.recommendation %}<span class="composer-opportunity">★ {{ shift.recommendation }}</span>{% endif %}
                </span>
            </label>
        {% else %}
            <div class="trade-option-blocked"
                 data-swap-composer-target="option"
                 data-date="{{ shift.date }}"
                 data-shift-key="{{ shift.key }}"
                 data-headline="{{ shift.dateHeadline }}"
                 data-hours="{{ shift.hours }}"
                 data-duration="{{ shift.durationLabel }}"
                 data-shift-label="{{ shift.shiftLabel }}"
                 data-blocked-reason="{{ shift.blockedReason }}">
                <span class="trade-option-unavailable"><b aria-hidden="true">×</b> {{ authorName }} no puede</span>
                <strong class="swap-card-date">{{ shift.dateHeadline|upper }}</strong>
                <span class="shift-card-hours">{{ shift.hours }}</span>
                <span class="shift-card-duration">{{ shift.durationLabel|upper }}</span>
                <strong>{{ shift.shiftLabel }}</strong>
                <span class="composer-blocked-reason">{{ shift.blockedReason }}</span>
            </div>
        {% endif %}
    {% else %}
        <div class="empty-state">
            <strong>No tienes turnos en estas cuatro semanas.</strong>
            <span>Prueba con las semanas siguientes.</span>
        </div>
    {% endfor %}
</div>
