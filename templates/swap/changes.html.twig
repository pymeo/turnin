{% extends 'base.html.twig' %}

{% block title %}Turnin — Cambios{% endblock %}
{% block description %}Di qué turno quieres librar y mira los de tus compañeros.{% endblock %}

{% block body %}
{% set forYou = openRequests|filter(request => request.canCover) %}
{% set waiting = proposals|filter(proposal => proposal.decidable) %}
<main class="changes-shell" data-controller="changes"
      data-changes-csrf-value="{{ csrfToken }}"
      data-changes-upcoming-value="{{ setup.upcomingShifts|json_encode|e('html_attr') }}"
      data-changes-working-dates-value="{{ setup.workingDates|json_encode|e('html_attr') }}"
      data-changes-groups-value="{{ groups|json_encode|e('html_attr') }}"
      data-changes-availability-value="{{ myAvailability|json_encode|e('html_attr') }}"
      data-changes-from-value="{{ setup.calendarFrom }}"
      data-changes-to-value="{{ setup.calendarTo }}">
    {% include 'identity/_authenticated_header.html.twig' %}

    <header class="changes-heading">
        <a class="text-sm text-ink-muted no-underline" href="{{ path('identity_app') }}">‹ Inicio</a>
        <h1>Cambios</h1>
    </header>

    {# One thing to do, and it is the thing people open the app for. #}
    <button class="changes-action changes-action-primary" type="button" data-action="changes#startRelease">
        <span class="changes-action-icon" aria-hidden="true">↗</span>
        <span><strong>Quiero librar un turno</strong><small>Elige uno de tus próximos turnos.</small></span>
        <span aria-hidden="true">›</span>
    </button>

    {% if waiting|length %}
        <section class="flex flex-col gap-3" aria-labelledby="waiting-title">
            <h2 id="waiting-title" class="changes-section-title">Te están esperando</h2>
            {% for proposal in waiting %}
                <a class="swap-card no-underline" href="{{ path('swap_proposal_decision', {proposalId: proposal.proposalId}) }}">
                    <p class="changes-kicker">{{ proposal.otherName }} te hace el turno</p>
                    <p class="swap-card-date">{{ proposal.requestedHeadline|upper }}</p>
                    <p class="shift-card-hours">{{ proposal.requestedHours }}</p>
                    <p class="verdict verdict-yes">Elige qué turno tuyo le haces</p>
                </a>
            {% endfor %}
        </section>
    {% endif %}

    <section class="flex flex-col gap-3" aria-labelledby="for-you-title">
        <h2 id="for-you-title" class="changes-section-title">Para ti</h2>
        {% for request in forYou|slice(0, 3) %}
            {% include 'swap/_colleague_shift_card.html.twig' with {request: request} only %}
        {% else %}
            <div class="empty-state"><strong>Ahora mismo no puedes hacer ningún turno de tus compañeros.</strong><span>Te avisaremos cuando aparezca uno que encaje contigo.</span></div>
        {% endfor %}
        {% if openRequests|length %}
            <a class="btn-secondary btn-block" href="{{ path('swap_changes_available') }}">Turnos de compañeros ({{ openRequests|length }})</a>
        {% endif %}
    </section>

    <section class="changes-summary" aria-labelledby="mine-title">
        <div>
            <p class="changes-kicker">Mis turnos publicados</p>
            <h2 id="mine-title">
                {% if myRequests|length %}
                    {{ myRequests|length }} {{ myRequests|length == 1 ? 'turno buscando compañero' : 'turnos buscando compañero' }}
                {% else %}
                    No estás intentando librar ningún turno
                {% endif %}
            </h2>
        </div>
        {% if myRequests|length %}<a class="btn-secondary" href="{{ path('swap_changes_mine') }}">Ver</a>{% endif %}
    </section>

    {# Useful, but never competing with the two actions above. #}
    <details class="composer-extra">
        <summary>Más opciones</summary>
        <button class="changes-action" type="button" data-action="changes#startAvailability">
            <span class="changes-action-icon" aria-hidden="true">＋</span>
            <span><strong>Puedo trabajar</strong><small>Días que te vendría bien trabajar. No hace falta para cambiar.</small></span>
            <span aria-hidden="true">›</span>
        </button>
        <a class="btn-secondary btn-block" href="{{ path('swap_proposals') }}">Mis intercambios</a>
        <a class="btn-secondary btn-block" href="{{ path('swap_bridge_finder') }}">✨ Encuéntrame un puente</a>
    </details>

    <p class="field-error hidden" data-changes-target="error" role="alert"></p>

    {% include 'swap/_flows.html.twig' %}
</main>
{% endblock %}
