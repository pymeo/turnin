{% extends 'base.html.twig' %}
{% block title %}Crear cuenta — Turnin{% endblock %}
{% block body %}<main class="page flex flex-col gap-6"><a href="{{ path('web_home') }}" class="btn-ghost">← Turnin</a><header class="flex flex-col gap-2"><h1 class="text-3xl font-bold">Crear tu cuenta</h1><p class="text-ink-muted">Solo necesitaremos tu centro de trabajo después.</p></header>{% if error %}<p class="alert-critical" role="alert">{{ error }}</p>{% endif %}{% include 'identity/_google_button.html.twig' %}<div class="flex items-center gap-3 text-sm text-ink-muted" aria-hidden="true"><span class="h-px flex-1 bg-line"></span><span>o</span><span class="h-px flex-1 bg-line"></span></div><form method="post" class="flex flex-col gap-5"><label class="field"><span class="field-label">Email</span><input class="input" type="email" name="email" autocomplete="email" required></label><label class="field"><span class="field-label">Contraseña</span><input class="input" type="password" name="password" minlength="10" autocomplete="new-password" required></label><label class="field"><span class="field-label">Repetir contraseña</span><input class="input" type="password" name="password_repeat" minlength="10" autocomplete="new-password" required></label><input type="hidden" name="_token" value="{{ csrf_token('register') }}"><button class="btn-secondary btn-block" type="submit">Crear cuenta con email</button></form><p class="text-center text-ink-muted">¿Ya tienes cuenta? <a class="text-brand-700 underline" href="{{ path('identity_login') }}">Iniciar sesión</a></p></main>{% endblock %}
