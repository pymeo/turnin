{% extends 'base.html.twig' %}
{% block title %}Crear cuenta — TURNIN{% endblock %}
{% block body %}
<main class="auth-shell">
    <section class="auth-panel">
        <a href="{{ path('web_home') }}" aria-label="Volver a TURNIN"><img class="brand-lockup" src="/brand/turnin-logo.svg" alt="TURNIN" width="230" height="64"></a>
        <header class="flex flex-col gap-2"><p class="eyebrow">Empieza en un minuto</p><h1 class="text-3xl font-bold tracking-tight">Crear tu cuenta</h1><p class="text-ink-muted">Después te ayudaremos a encontrar tu centro y tu equipo.</p></header>
        {% if error %}<p class="alert-critical" role="alert">{{ error }}</p>{% endif %}
        {% include 'identity/_google_button.html.twig' %}
        <div class="flex items-center gap-3 text-sm text-ink-muted" aria-hidden="true"><span class="h-px flex-1 bg-line"></span><span>o continúa con email</span><span class="h-px flex-1 bg-line"></span></div>
        <form method="post" class="flex flex-col gap-5">
            <label class="field"><span class="field-label">Email</span><input class="input" type="email" name="email" autocomplete="email" required></label>
            <label class="field"><span class="field-label">Contraseña</span><input class="input" type="password" name="password" minlength="10" autocomplete="new-password" required></label>
            <label class="field"><span class="field-label">Repetir contraseña</span><input class="input" type="password" name="password_repeat" minlength="10" autocomplete="new-password" required></label>
            <input type="hidden" name="_token" value="{{ csrf_token('register') }}"><button class="btn-primary btn-block" type="submit">Crear cuenta con email</button>
        </form>
        <p class="text-center text-ink-muted">¿Ya tienes cuenta? <a class="font-semibold text-brand-700 underline" href="{{ path('identity_login') }}">Iniciar sesión</a></p>
    </section>
    <aside class="auth-visual"><img src="/brand/turnin-logo-light.svg" alt="TURNIN" width="230" height="64"><div><h2 class="text-3xl font-bold">Un equipo.<br>Más posibilidades.</h2><p class="mt-3 text-brand-100">Porque detrás de cada turno, hay personas.</p></div><img src="/brand/turnin-workers.svg" alt="" width="920" height="380"></aside>
</main>
{% endblock %}
