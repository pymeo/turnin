{% extends 'base.html.twig' %}
{% block title %}Turnin — Inicio{% endblock %}
{% block body %}
<main class="page flex flex-col gap-6">
    {% include 'identity/_authenticated_header.html.twig' %}

    <header>
        <p class="text-ink-muted">Hola</p>
        <h1 class="text-3xl font-bold">{{ user.hasWorkerProfile ? 'Tu grupo de trabajo' : 'Tu área de responsable' }}</h1>
    </header>

    {% if app.request.query.get('responsable') == 'dejado' %}
        <p class="alert-success" role="status">Has dejado de ser responsable. Tu historial se conserva.</p>
    {% elseif app.request.query.get('responsable') == 'rechazado' %}
        <p class="alert-info" role="status">Has rechazado la invitación. Avisaremos a quien te la envió.</p>
    {% elseif app.request.query.get('responsable') == 'solicitado' %}
        <p class="alert-success" role="status">Hemos pedido a tus compañeros que confirmen que eres su responsable.</p>
    {% elseif app.request.query.get('responsable') == 'en-curso' %}
        <p class="alert-info" role="status">Ya tienes una verificación en curso. Aquí puedes ver su progreso.</p>
    {% elseif app.request.query.get('responsable') == 'ya-verificado' %}
        <p class="alert-info" role="status">Ya eres responsable verificado de este equipo.</p>
    {% endif %}

    {# Supervision comes first while it needs something from this person: a
       pending request is the main thing on the home until the team answers. #}
    {% include 'workforce/_supervision_home.html.twig' with {overview: supervision_overview(user.id), approvalCounts: pending_approval_counts(user.id)} only %}

    {% if user.hasWorkerProfile %}

    {# The calendar is the thing that makes everything else possible, so it is
       the first card and the only primary action. Skippable on purpose: nobody
       is blocked out of Turnin for not having filled in their rota yet. #}
    <section class="card flex flex-col gap-3">
        <p class="text-lg font-semibold">Añade tu cuadrante</p>
        <p class="text-ink-muted">
            Píntalo, repite tu patrón o dínoslo por voz. Con tu calendario en Turnin
            podremos ayudarte de verdad con tus cambios.
        </p>
        <a class="btn-primary btn-block" href="{{ path('scheduling_calendar') }}">Abrir mi calendario</a>
    </section>

    <section class="card flex flex-col gap-2">
        <p class="text-lg font-semibold">Tu perfil laboral está listo</p>
        <p class="text-ink-muted">Aquí aparecerán tus compañeros compatibles.</p>
    </section>

    <section class="card flex flex-col gap-3">
        <p class="text-xl font-semibold">❤️ Cuadrar turnos</p>
        <p class="text-ink-muted">Compara tu calendario con alguien importante para ti y encuentra días que podéis intentar librar juntos.</p>
        <a class="btn-secondary btn-block" href="{{ path('coordination_together') }}">Sincronizar calendarios</a>
    </section>

    <nav class="flex flex-col gap-3">
        <a class="btn-primary btn-block" href="{{ path('swap_changes', {flow: 'release'}) }}">Quiero librar un turno</a>
        <a class="btn-secondary btn-block" href="{{ path('swap_changes', {flow: 'availability'}) }}">Puedo trabajar</a>
        <a class="btn-ghost btn-block" href="{{ path('swap_changes') }}">Ver cambios</a>
        <a class="btn-ghost btn-block" href="{{ path('workforce_team') }}">Mi equipo y responsables</a>
        <a class="btn-ghost btn-block" href="{{ path('workforce_assignments') }}">Mis lugares de trabajo</a>
    </nav>
    {% else %}
    <section class="card flex flex-col gap-2">
        <p class="text-lg font-semibold">¿También trabajas a turnos?</p>
        <p class="text-ink-muted">Con la misma cuenta puedes completar tu perfil laboral y cambiar tus propios turnos.</p>
        <a class="btn-secondary btn-block" href="{{ path('workforce_onboarding') }}">Completar mi perfil laboral</a>
    </section>
    {% endif %}
</main>
{% endblock %}
