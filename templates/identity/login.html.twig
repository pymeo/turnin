{% extends 'base.html.twig' %}
{% block title %}Iniciar sesión — Turnin{% endblock %}
{% block body %}<main class="page flex flex-col gap-6"><a href="{{ path('web_home') }}" class="btn-ghost">← Turnin</a><header class="flex flex-col gap-2"><h1 class="text-3xl font-bold">Iniciar sesión</h1><p class="text-ink-muted">Vuelve a tu grupo de trabajo.</p></header>{% if authentication_error %}<p class="alert-critical" role="alert">{{ authentication_error }}</p>{% endif %}{% include 'identity/_google_button.html.twig' %}<div class="flex items-center gap-3 text-sm text-ink-muted" aria-hidden="true"><span class="h-px flex-1 bg-line"></span><span>o</span><span class="h-px flex-1 bg-line"></span></div><form method="post" action="{{ path('identity_login') }}" class="flex flex-col gap-5"><label class="field"><span class="field-label">Email</span><input class="input" type="email" name="_username" autocomplete="email" value="{{ last_email }}" required></label><label class="field"><span class="field-label">Contraseña</span><input class="input" type="password" name="_password" autocomplete="current-password" required></label><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="btn-secondary btn-block" type="submit">Iniciar sesión</button></form><p class="text-center text-ink-muted">¿No tienes cuenta? <a class="text-brand-700 underline" href="{{ path('identity_register') }}">Crear cuenta</a></p></main>{% endblock %}
