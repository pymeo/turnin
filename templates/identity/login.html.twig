{% extends 'base.html.twig' %}
{% block title %}Iniciar sesión — TURNIN{% endblock %}
{% block body %}
<main class="auth-shell">
    <section class="auth-panel">
        <a href="{{ path('web_home') }}" aria-label="Volver a TURNIN"><img class="brand-lockup" src="/brand/turnin-logo.svg" alt="TURNIN" width="230" height="64"></a>
        <header class="flex flex-col gap-2"><p class="eyebrow">Qué alegría verte</p><h1 class="text-3xl font-bold tracking-tight">Iniciar sesión</h1><p class="text-ink-muted">Vuelve a tus turnos y a tu equipo.</p></header>
        {% if authentication_error %}<p class="alert-critical" role="alert">{{ authentication_error }}</p>{% endif %}
        {% include 'identity/_google_button.html.twig' %}
        <div class="flex items-center gap-3 text-sm text-ink-muted" aria-hidden="true"><span class="h-px flex-1 bg-line"></span><span>o continúa con email</span><span class="h-px flex-1 bg-line"></span></div>
        <form method="post" action="{{ path('identity_login') }}" class="flex flex-col gap-5">
            <label class="field"><span class="field-label">Email</span><input class="input" type="email" name="_username" autocomplete="email" value="{{ last_email }}" required></label>
            <label class="field"><span class="field-label">Contraseña</span><input class="input" type="password" name="_password" autocomplete="current-password" required></label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="btn-primary btn-block" type="submit">Iniciar sesión</button>
        </form>
        <p class="text-center text-ink-muted">¿No tienes cuenta? <a class="font-semibold text-brand-700 underline" href="{{ path('identity_register') }}">Crear cuenta</a></p>
    </section>
    <aside class="auth-visual"><img src="/brand/turnin-logo-light.svg" alt="TURNIN" width="230" height="64"><div><h2 class="text-3xl font-bold">Cambia turnos.<br>Sigue avanzando.</h2><p class="mt-3 text-brand-100">Más flexibilidad para quienes siempre están ahí.</p></div><img src="/brand/turnin-workers.svg" alt="" width="920" height="380"></aside>
</main>
{% endblock %}
