# Committed defaults. This file is read by BOTH Docker Compose and Symfony, so
# it holds infrastructure wiring only — never a real secret.
#
# Loading order (later wins):
#   .env  →  .env.$APP_ENV  →  .env.local  →  .env.$APP_ENV.local  →  real env vars
#
# Put machine-specific overrides in .env.local (git-ignored). In production the
# values below are supplied by the environment, not by a file.

###> docker compose ###
# Host-side knobs for `docker compose`. HOST_UID/HOST_GID keep files created
# inside the container owned by you on the host.
HOST_UID=1000
HOST_GID=1000
HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_VERSION=18
POSTGRES_DB=turnin
POSTGRES_USER=turnin
# Local-only credential. Production injects DATABASE_URL from the environment.
POSTGRES_PASSWORD=turnin
XDEBUG_MODE=off
###< docker compose ###

###> symfony/framework-bundle ###
APP_ENV=dev
# Deliberately empty: dev/test values live in .env.dev / .env.test and
# production must inject a real one. An empty secret fails loudly in prod.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://turnin:turnin@postgres:5432/turnin?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> redis ###
REDIS_URL=redis://redis:6379
###< redis ###

###> symfony/messenger ###
# Everything is handled synchronously for now. Redis is already running and is
# where the async transport will point when the first slow use case appears
# (matching, notifications, imports) — see docs/ARCHITECTURE.md.
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###
